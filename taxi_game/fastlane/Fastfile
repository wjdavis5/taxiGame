# Submission lane for the iOS release workflow.
#
# Only submission lives here. Building, signing, and the TestFlight upload are
# done by xcodebuild and altool in .github/workflows/ios-release.yml — fastlane
# is used for the one job those tools cannot do, which is creating an App Store
# version and putting it in front of review.

default_platform(:ios)

APP_IDENTIFIER = "com.wjdavis5.taxigame".freeze

platform :ios do
  desc "Attach the current build to its App Store version and submit for review"
  lane :submit do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_PRIVATE_KEY"),
      in_house: false,
    )

    version = ENV.fetch("DELIVER_APP_VERSION")
    build_number = ENV.fetch("DELIVER_BUILD_NUMBER")

    wait_until_processed(version, build_number)

    # Deliver cannot be trusted with the release type under skip_metadata
    # (issue #111) — set it on the version record before the submit.
    set_manual_release(version)

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: version,
      build_number: build_number,
      submit_for_review: true,

      # Decorative under `skip_metadata: true` (issue #111): deliver reads
      # this flag only inside the metadata upload that skip skips, so the
      # release type is set explicitly by `set_manual_release` above. Kept
      # so the intent still reads in the call — and so it takes effect
      # automatically if skip_metadata ever comes off.
      automatic_release: false,

      # Listing copy and screenshots are maintained in App Store Connect. This
      # lane submits what is already there and never overwrites it.
      skip_metadata: true,
      skip_screenshots: true,
      skip_binary_upload: true,

      # Non-interactive: no HTML preview, no confirmation prompt.
      force: true,
      run_precheck_before_submit: false,

      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      },
    )
  end
end

# Apple processes an upload asynchronously and a build cannot be attached to a
# version — let alone submitted — until that finishes. Poll the target build's
# own processing state rather than anything about which builds are listed: a
# fresh upload appears in the Connect API within seconds of altool finishing,
# still PROCESSING, so a wait keyed on "the build shows up" (the old
# latest-build-number poll) races the processing and hands deliver a build it
# cannot yet attach — which is exactly where a version-bump release died
# (issue #79).
#
# The state is read as the raw string, not fastlane's `build.processed?`
# helper: the helper is merely `processing_state != PROCESSING`, so FAILED and
# INVALID builds count as "processed" and would sail the wait straight into a
# submit that can never succeed. Those two states end the wait immediately
# with the real error named — a build in them will never become submittable,
# and 45 more minutes of polling would only bury it.
#
# No token plumbing: the lane's `app_store_connect_api_key` call has already
# set `Spaceship::ConnectAPI.token` (that is its `set_spaceship_token: true`
# default), and `Build.all` rides that global client.
def wait_until_processed(version, build_number, timeout_minutes: 45)
  deadline = Time.now + (timeout_minutes * 60)
  target = build_number.to_s

  # The build filter speaks the numeric App Store Connect id, not the bundle
  # identifier — resolve it once, before the polling loop.
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("No App Store Connect app found for #{APP_IDENTIFIER}.") if app.nil?

  loop do
    # The platform must be fastlane's own wire constant, never `:ios`:
    # Build.all applies the platform *after* fetching, comparing raw
    # (`build.pre_release_version.platform == platform`, no normalization),
    # and the API reports the uppercase String "IOS" — a lowercase Symbol
    # matches nothing, every build filters out client-side, and the wait
    # starves to the 45-minute timeout with "not yet listed" (the review
    # finding that blocked this PR).
    states = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: version,
      build_number: target,
      platform: Spaceship::ConnectAPI::Platform::IOS,
    ).map(&:processing_state).uniq

    if states == ["VALID"]
      UI.success("Build #{target} for #{version} has finished processing.")
      return
    end
    if states.include?("FAILED") || states.include?("INVALID")
      UI.user_error!(
        "Build #{target} for #{version} finished processing as " \
        "#{states.join(', ')} — it cannot be submitted. Check App Store " \
        "Connect for the processing error."
      )
    end

    if Time.now > deadline
      UI.user_error!(
        "Build #{target} for #{version} was still not processed after " \
        "#{timeout_minutes} minutes (last seen: " \
        "#{states.empty? ? 'not yet listed' : states.join(', ')}). " \
        "The upload may have been rejected — check App Store Connect."
      )
    end

    UI.message(
      "Waiting for build #{target} to process " \
      "(state: #{states.empty? ? 'not yet listed' : states.join(', ')})...",
    )
    sleep(60)
  end
end

# Pins the App Store version's release type to MANUAL (issue #111).
#
# `automatic_release: false` in the deliver call is inert here: deliver
# reads it only inside Deliver::UploadMetadata#upload, whose first line
# is `return if options[:skip_metadata]` — and this lane submits with
# `skip_metadata: true` so it never overwrites the listing maintained in
# App Store Connect. Left to deliver, the version keeps ASC's default
# releaseType (AFTER_APPROVAL) and an approved build would go live on
# its own — shipping becomes a side effect of a merge, exactly what the
# flag was meant to prevent.
#
# So the lane writes the release type itself, through the Spaceship
# token `app_store_connect_api_key` has already left in place (the same
# global `wait_until_processed` rides). `ensure_version!` is deliver's
# own find-or-create primitive for the editable App Store version — it
# returns whether anything changed, not the version, so the editable
# record is fetched afterwards and PATCHed to MANUAL. The write lands
# before `deliver`, so the review submission carries it; nothing in
# deliver's submit path (`SubmitForReview#submit!`) touches releaseType,
# and the metadata upload that would returns before reading it.
#
# An ASC-side failure here surfaces inside the workflow's submit step,
# which carries `continue-on-error` — the TestFlight build the run
# already uploaded is never stranded by it.
def set_manual_release(version)
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("No App Store Connect app found for #{APP_IDENTIFIER}.") if app.nil?

  platform = Spaceship::ConnectAPI::Platform::IOS
  app.ensure_version!(version, platform: platform)
  editable = app.get_edit_app_store_version(platform: platform)
  UI.user_error!("No editable App Store version for #{version}.") if editable.nil?
  editable.update(
    attributes: {
      releaseType: Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::MANUAL,
    },
  )
  UI.success(
    "Release type for #{version} is MANUAL — the approved build ships " \
    "only when a human releases it in App Store Connect.",
  )
end
